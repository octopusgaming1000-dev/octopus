// PROVIDER INFRASTRUCTURE

model ProviderMapping {
  id                String   @id @default(cuid())
  entityType        String   // "team", "player", "competition", "match", "referee", "venue"
  octopusEntityId   String
  provider          String   // "match_api", "fbref", "understat", "weather", "referee"
  providerEntityId  String
  providerName      String?  // Optional: normalized name from provider
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([entityType, provider, providerEntityId])
  @@index([entityType])
  @@index([octopusEntityId])
  @@index([provider])
  @@map("provider_mappings")
}

model ProviderRawData {
  id              String   @id @default(cuid())
  provider        String   // "match_api", "fbref", "understat", "weather", "referee"
  endpoint        String
  externalId      String?
  payloadJson     String   // JSON string of raw response
  fetchedAt       DateTime @default(now())
  contentHash     String   // Hash of payload for deduplication
  status          String   @default("success") // "success", "error"
  errorMessage    String?

  @@index([provider])
  @@index([endpoint])
  @@index([externalId])
  @@index([fetchedAt])
  @@map("provider_raw_data")
}

model ProviderSyncLog {
  id                String   @id @default(cuid())
  provider          String   // "match_api", "fbref", "understat", "weather", "referee"
  syncType          String   // "daily_fixtures", "match_details", "statistics", "lineups", "events"
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  status            String   @default("running") // "running", "completed", "failed", "partial"
  recordsFetched    Int      @default(0)
  recordsCreated    Int      @default(0)
  recordsUpdated    Int      @default(0)
  recordsSkipped    Int      @default(0)
  errorCount        Int      @default(0)
  errorMessage      String?
  metadata          String?  // JSON string for additional context

  @@index([provider])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("provider_sync_logs")
}

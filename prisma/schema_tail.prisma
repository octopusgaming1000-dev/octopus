  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  provider      String?   // 'email' | 'google'
  providerId    String?   // Google user ID
  name          String?   // User's display name
  image         String?   // Profile image URL
  tier          String    @default("FREE") // FREE | PRO | CREATOR | ENTERPRISE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  bookingCodes      BookingCode[]
  analyses          Analysis[]
  userProfile       UserProfile?
  analysisHistory    AnalysisHistory[]
  userAnalyses      UserAnalysis[]
  communityPredictions CommunityPrediction[]
  usageMetrics      UsageMetric[]
  subscription      Subscription?
  matchCommunityPredictions MatchCommunityPrediction[]
  chatMessages      ChatMessage[]
  messageReactions  MessageReaction[]
  predictions      Prediction[]
  userReputation   UserReputation?
  dailyMissions    DailyMission[]
  userMissionProgress UserMissionProgress[]
  userStreak       UserStreak?
  userBadges       UserBadge[]
  notifications     Notification[]
  feedItems        FeedItem[]
  userPreferences   UserPreferences?
  
  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  reputationScore  Int      @default(0)
  riskFlag        String   @default("neutral")
  correctPredictions Int      @default(0)
  totalPredictions  Int      @default(0)
  accuracyRate    Float     @default(0.0)
  
  // Community Intelligence fields
  trustScore      Int      @default(50)     // 0-100 scale
  starRating      Int      @default(3)      // 1-5 scale
  riskLabel       String   @default("Medium") // Low, Medium, High
  influenceWeight Float    @default(0.5)    // Weight in community calculations
  lastAccuracyUpdate DateTime? // When accuracy was last recalculated
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model AnalysisHistory {
  id          String   @id @default(cuid())
  userId      String
  status      String   // 'completed' | 'failed' | 'pending'
  code        String   // Booking code analyzed
  result      String   // Analysis result data (JSON stored as text)
  createdAt    DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("analysis_history")
}

model UserAnalysis {
  id            String    @id @default(cuid())
  userId        String
  title         String    // User-friendly title for the analysis
  bookingCode   String?   // Original booking code if available
  isGuest       Boolean   @default(false) // Whether this was a guest analysis
  analysisData  String    // Complete analysis data (JSON stored as text)
  slipRisk      String?   // Slip risk summary (JSON stored as text)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches        UserAnalysisMatch[]
  
  @@index([userId])
  @@index([createdAt])
  @@map("user_analyses")
}

model UserAnalysisMatch {
  id                  String    @id @default(cuid())
  userAnalysisId      String
  homeTeam            String
  awayTeam            String
  market              String
  selection           String
  odds                Float
  probabilityRange     String    // JSON stored as text
  riskLevel           String
  explanation         String
  cautionNote         String
  createdAt           DateTime  @default(now())
  
  userAnalysis        UserAnalysis @relation(fields: [userAnalysisId], references: [id], onDelete: Cascade)
  communityPrediction CommunityPrediction?
  
  @@index([userAnalysisId])
  @@map("user_analysis_matches")
}

model CommunityPrediction {
  id                String    @id @default(cuid())
  userId             String
  userAnalysisMatchId String @unique
  market             String
  prediction         String    // 'Home', 'Draw', 'Away', 'Over', 'Under', 'Yes', 'No'
  confidence         Int       // 1-5 scale
  explanation        String    // User's reasoning
  isCorrect         Boolean?   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user               User     @relation(fields: [userId], references: [id])
  userAnalysisMatch  UserAnalysisMatch @relation(fields: [userAnalysisMatchId], references: [id], onDelete: Cascade)
  outcome            PredictionOutcome?
  
  @@index([userId])
  @@map("community_predictions")
}

model PredictionOutcome {
  id                  String    @id @default(cuid())
  communityPredictionId String   @unique
  actualResult        String    // Actual match result
  isCorrect           Boolean
  resolvedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  
  communityPrediction   CommunityPrediction @relation(fields: [communityPredictionId], references: [id], onDelete: Cascade)
  
  @@map("prediction_outcomes")
}

model BookingCode {
  id            String    @id @default(cuid())
  code          String
  bookmaker     String    // sportybet, bet9ja, betking, etc.
  userId        String?
  decodedData   String    // Normalized structure from decoder (JSON stored as text)
  createdAt     DateTime  @default(now())
  
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses      Analysis[]
  consensusData ConsensusData[]
  
  @@index([bookmaker])
  @@index([userId])
  @@map("booking_codes")
}

model Fixture {
  id              String    @id @default(cuid())
  homeTeam        String
  awayTeam        String
  competition     String
  matchDate       DateTime
  status          String    @default("scheduled") // scheduled, live, finished
  homeScore       Int?
  awayScore       Int?
  metadata        String?   // Additional fixture data (JSON stored as text)
  
  selections      Selection[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([homeTeam, awayTeam, matchDate])
  @@map("fixtures")
}

model Selection {
  id          String    @id @default(cuid())
  fixtureId   String
  market      String    // 1X2, Over/Under, Both Teams to Score, etc.
  selection   String    // Home, Draw, Away, Over 2.5, etc.
  odds        Float
  metadata    String?   // Market-specific data (JSON stored as text)
  
  fixture     Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  consensusData ConsensusData[]
  
  @@index([fixtureId])
  @@map("selections")
}

model Analysis {
  id                    String    @id @default(cuid())
  bookingCodeId         String
  userId                String?
  fixtureId             String?
  selectionId           String?
  
  // Analysis results
  impliedProbability    Float     // From odds
  combinedProbability    Float?    // For multi-selection slips
  riskLevel             String    // low, medium, high
  probabilityRange      String    // { min: 0.3, max: 0.7 } (JSON stored as text)
  
  // Analysis breakdown
  mathematicalAnalysis  String    // Implied probabilities, expected value (JSON stored as text)
  statisticalAnalysis    String?   // Form, H2H, trends (JSON stored as text)
  contextualAnalysis     String?   // Injuries, formations, referee, venue (JSON stored as text)
  
  // Explanation
  explanation            String    // Plain English explanation
  
  createdAt             DateTime  @default(now())
  
  bookingCode           BookingCode @relation(fields: [bookingCodeId], references: [id], onDelete: Cascade)
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  selection             Selection?  @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  
  @@index([bookingCodeId])
  @@index([userId])
  @@map("analyses")
}

model ConsensusData {
  id            String    @id @default(cuid())
  selectionId   String
  bookingCodeId String
  
  // Consensus metrics
  selectionCount    Int     // How many users selected this
  totalSubmissions  Int     // Total submissions analyzed
  percentage        Float   // Percentage of submissions
  
  summary           String  // "X% of submitted slips selected this market"
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  selection         Selection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  bookingCode       BookingCode @relation(fields: [bookingCodeId], references: [id], onDelete: Cascade)
  
  @@unique([selectionId, bookingCodeId])
  @@index([selectionId])
  @@map("consensus_data")
}

model Match {
  id              String    @id @default(cuid())
  homeTeam        String
  awayTeam        String
  league          String
  kickoffTime     DateTime
  venue           String?
  weather         String?   // Weather conditions
  status          String    @default("scheduled") // scheduled, live, finished
  homeScore       Int?
  awayScore       Int?
  source          String    @default("manual") // manual, fixture_api, etc.
  
  // AI Analysis caching
  aiAnalysis      String?   // Cached AI analysis (JSON stored as text)
  aiAnalysisAt    DateTime? // When AI was last run
  
  // Relations
  competitionId   String?
  competition     Competition?   @relation(fields: [competitionId], references: [id])
  matchCommunityPredictions MatchCommunityPrediction[]
  communityIntelligence CommunityIntelligence[]
  chatRooms      ChatRoom[]
  predictions     Prediction[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([league, kickoffTime])
  @@index([homeTeam, awayTeam])
  @@index([status])
  @@index([source])
  @@index([competitionId])
  @@map("matches")
}

model MatchCommunityPrediction {
  id                String    @id @default(cuid())
  matchId           String
  userId            String
  market            String    // 1X2, Over/Under, etc.
  prediction        String    // Home, Draw, Away, Over, Under, etc.
  confidence        Int       // 1-5 scale
  explanation       String    // User's reasoning
  isCorrect         Boolean?  @default(false)
  upvotes           Int       @default(0)
  downvotes         Int       @default(0)
  
  // Community Intelligence fields
  confidenceNote    String?   // Optional confidence note
  influenceWeight   Float     @default(1.0)  // Weight based on user trust
  isSpam            Boolean   @default(false)  // Flagged as spam
  spamScore         Float     @default(0.0)    // Spam detection score
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match             Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([matchId])
  @@index([userId])
  @@unique([matchId, userId, market])
  @@map("match_community_predictions")
}

model CommunityIntelligence {
  id              String    @id @default(cuid())
  matchId         String
  market          String    // 1X2, Over/Under, etc.
  
  // Aggregated community data
  totalPredictions Int       @default(0)
  trustedPredictions Int     @default(0)  // From trusted users only
  communityAgreement Float   @default(0.0)  // 0-1 scale
  communityConfidence Float   @default(0.0)  // 0-1 scale
  
  // Weighted predictions
  weightedHome     Float     @default(0.0)
  weightedDraw     Float     @default(0.0)
  weightedAway     Float     @default(0.0)
  weightedOver      Float     @default(0.0)
  weightedUnder    Float     @default(0.0)
  weightedYes      Float     @default(0.0)
  weightedNo       Float     @default(0.0)
  
  // Community sentiment analysis
  sentiment        String?   // bullish, bearish, neutral
  riskAdjustment   Float     @default(0.0)  // Risk adjustment factor
  confidenceAdjustment Float @default(0.0)  // Confidence adjustment factor
  
  // Anti-manipulation metrics
  userDiversity    Float     @default(0.0)  // How diverse the predictions are
  spamRatio        Float     @default(0.0)  // Ratio of spam predictions
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  match            Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  @@unique([matchId, market])
  @@index([matchId, market])
  @@map("community_intelligence")
}

model VerificationToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  
  @@index([email, token])
  @@map("verification_tokens")
}

// Usage metrics for analytics and tier limits
model UsageMetric {
  id              String    @id @default(cuid())
  userId          String
  date            String    // YYYY-MM-DD format
  analysesCount   Int       @default(0)
  apiCallsCount   Int       @default(0)
  sessionDuration Int       @default(0) // in seconds
  featuresUsed    String    // JSON array of feature IDs used
  lastActiveAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
  @@map("usage_metrics")
}

// Subscription model for future monetization
model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  tier            String    // FREE | PRO | CREATOR | ENTERPRISE
  status          String    @default("inactive") // active | inactive | cancelled | expired
  startDate       DateTime?
  endDate         DateTime?
  billingCycle    String?   // monthly | yearly
  price           Float?    // Price in cents
  currency        String?   @default("USD")
  paymentMethod   String?   // stripe | paypal | etc
  subscriptionId  String?   // External subscription ID
  lastBilledAt    DateTime?
  nextBillingAt    DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
  @@index([status])
  @@map("subscriptions")
}

// Competition model for league communities
model Competition {
  id          String   @id @default(cuid())
  name        String   @unique // "Premier League", "La Liga", etc.
  displayName String   // "Premier League", "La Liga", etc.
  country     String?  // "England", "Spain", etc.
  logo        String?  // Competition logo URL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  matches     Match[]
  chatRooms   ChatRoom[]
  
  @@index([isActive])
  @@map("competitions")
}

// Chat Room model
model ChatRoom {
  id           String   @id @default(cuid())
  type         String   // "global", "competition", "match"
  referenceId  String?  // competition_id or match_id for non-global rooms
  name         String   // Room display name
  description  String?  // Room description
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  messages     ChatMessage[]
  competition   Competition? @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  match        Match?       @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  
  @@index([type, referenceId])
  @@index([isActive])
  @@map("chat_rooms")
}

// Chat Message model
model ChatMessage {
  id          String    @id @default(cuid())
  roomId      String
  userId      String
  message     String
  replyToId   String?   // For threaded replies
  isEdited    Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  
  // Relations
  room        ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     ChatMessage?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChatMessage[]    @relation("MessageReplies")
  reactions   MessageReaction[]
  
  @@index([roomId, createdAt])
  @@index([userId, createdAt])
  @@index([replyToId])
  @@map("chat_messages")
}

// Message Reaction model
model MessageReaction {
  id           String   @id @default(cuid())
  messageId    String
  userId       String
  reactionType String   // "👍", "🔥", "😂", "👎", etc.
  createdAt    DateTime @default(now())
  
  // Relations
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, userId, reactionType])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

// Credibility System Models

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  marketType    String   // "1X2", "OVER_UNDER_2_5", "BTTS", "OVER_UNDER_CORNERS", "CARDS_OVER_UNDER", "AI_GENERATED"
  predictedValue String   // e.g., "1", "OVER", "YES", "2.5", "9.5"
  confidence    Int      @default(3) // 1-5 stars
  createdAt     DateTime @default(now())
  lockedAt      DateTime?
  result        String   @default("pending") // "pending", "won", "lost"
  
  // Relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  auditLogs     PredictionAuditLog[]
  
  @@index([userId, matchId])
  @@index([matchId, result])
  @@index([createdAt])
  @@map("predictions")
}

model UserReputation {
  id                  String   @id @default(cuid())
  userId              String   @unique
  totalPredictions    Int      @default(0)
  correctPredictions  Int      @default(0)
  accuracyScore       Float    @default(0.0)
  reputationPoints    Int      @default(0)
  rankTier           String   @default("Beginner") // "Beginner", "Analyst", "Expert", "Elite", "Verified Predictor"
  lastUpdated        DateTime @updatedAt
  
  // Relations
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictions         Prediction[] @relation(fields: [userId], references: [userId])
  
  @@index([reputationPoints])
  @@index([accuracyScore])
  @@map("user_reputations")
}

model PredictionAuditLog {
  id          String   @id @default(cuid())
  predictionId String
  oldState    String   // JSON string of previous state
  newState    String   // JSON string of new state
  changedAt   DateTime @default(now())
  
  // Relations
  prediction  Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  
  @@index([predictionId])
  @@index([changedAt])
  @@map("prediction_audit_logs")
}

// Daily Engagement System Models

model DailyMission {
  id               String   @id @default(cuid())
  date             String   // YYYY-MM-DD format
  missionType      String   // "PREDICT_3_MATCHES", "PARTICIPATE_DISCUSSION", "REACT_5_PREDICTIONS", "HIGH_CONFIDENCE_PREDICTION", "ANALYZE_AI_PREDICTION"
  requirementValue Int      // e.g., 3, 1, 5, 4, 1
  description      String   // Human-readable description
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  
  // Relations
  userProgress     UserMissionProgress[]
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([date, missionType])
  @@index([date])
  @@index([isActive])
  @@map("daily_missions")
}

model UserMissionProgress {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  
  @@unique([userId, missionId])
  @@index([userId, completed])
  @@index([completedAt])
  @@map("user_mission_progress")
}

model UserStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String?  // YYYY-MM-DD format
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([currentStreak])
  @@index([longestStreak])
  @@map("user_streaks")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String   // "7_DAY_ACTIVE", "30_DAY_ANALYST", "CONSISTENCY_MASTER"
  badgeName   String   // Display name
  badgeIcon   String   // Emoji or icon
  earnedAt    DateTime @default(now())
  
  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, badgeType])
  @@index([userId])
  @@index([badgeType])
  @@map("user_badges")
}

// Real-Time Notification and Feed System Models

model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String   // "match_starting", "match_finished", "ai_confidence_spike", "lineup_released", "red_card", "penalty", "halftime", "fulltime", "comment_reply", "prediction_liked", "top_predictor", "rank_upgrade", "streak_milestone", "daily_missions", "community_announcement"
  title           String
  message         String
  relatedMatchId  String?
  relatedUserId   String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                 String   @unique
  notifyMatchEvents      Boolean  @default(true)
  notifySocial           Boolean  @default(true)
  notifyAIAlerts        Boolean  @default(true)
  notifyDailyMissions   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  // Relations
  user                   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

model FeedItem {
  id              String   @id @default(cuid())
  userId          String?
  type            String   // "match", "discussion", "ai_alert", "community"
  title           String
  description     String?
  metadata        String?  // JSON string for additional data
  relevanceScore   Float    @default(0.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  // Relations
  user            User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, relevanceScore, createdAt])
  @@index([type, isActive, createdAt])
  @@index([relevanceScore])
  @@index([createdAt])
  @@map("feed_items")
}


{
  "name": "octopus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "deploy": "chmod +x scripts/deploy-production.sh && ./scripts/deploy-production.sh",
    "seed:competitions": "npx tsx lib/seed-competitions.ts",
    "seed:matches": "npx tsx lib/seed-matches.ts",
    "seed:all": "npm run seed:competitions && npm run seed:matches",
    "test:moderation": "npx tsx lib/moderation-test.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@prisma/client": "^5.22.0",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.0.6",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.0.4",
    "next-auth": "^4.24.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",

# Database
DATABASE_URL="file:./dev.db"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
SOCKET_CORS_ORIGIN=http://localhost:3000

# JWT Secret (generate a strong secret for production)
JWT_SECRET="your-super-secret-jwt-key-here"
INTERNAL_API_KEY=your-internal-api-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production Settings
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Performance
ENABLE_CACHE=true
CACHE_DEFAULT_TTL=300

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Google OAuth (get these from Google Cloud Console)
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# SportyBet API (get these from SportyBet developer portal)
# 1. Contact SportyBet for API access
# 2. Get API key and endpoint URL
# 3. Add booking code lookup endpoint
SPORTYBET_API_URL="https://api.sportybet.com/v1"
SPORTYBET_API_KEY="your-sportybet-api-key-here"
